# Go's own formatter owns .go files; this exists so editors agree about
# everything gofmt does not touch.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

# Pulp is indentation-sensitive, so an editor silently retabbing a document
# changes its meaning. Spaces, and never strip trailing whitespace in a
# testdata golden file.
[*.{pulp,pulptheme}]
indent_style = space
indent_size = 2

[testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
