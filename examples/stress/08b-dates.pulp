        text "{week.number:%02d}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.12)
  column
    width: fill
    section
      height: 11pt
      column
        width: 104pt
        text "{{today:go:\"Jan 2 2006\"}}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.45)
      column
