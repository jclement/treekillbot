section
  height: auto
  valign: bottom
  text "The month grid, built from month.weeks — full rows that spill into the neighbouring months, because that is what a month on paper looks like. Weekends are set in grey; the SPILL days are not distinguished, because a ternary condition can only compare a path against a literal and `day.month.number == month.number` compares against the six characters of that path."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: 13pt
  padding-top: 4pt
  for name in Mon, Tue, Wed, Thu, Fri, Sat, Sun
    column
      align: center
      text "{name}"
        font-size: 6pt
        color: gray(0.45)
        align: center
        text-transform: upper
        tracking: 0.5pt

section
  height: 156pt
  for week in month.weeks
    section
      height: 26pt
      for day in week.days
        column
          border-width: 0.3pt
          border-color: gray(0.78)
          padding: 3pt
          text "{day.dd}"
            font-size: 8pt
            color: {day.weekend ? "gray(0.55)" : "gray(0.15)"}

section
  height: 24pt
  valign: bottom
  text "Format specs: named formats, strftime, and the Go layout escape hatch."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: 59pt
  padding-top: 4pt
  gap: 22pt
  column
    width: fill
    section
      height: 11pt
      column
        width: 104pt
        text "{{today:iso}}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.45)
      column
        width: fill
        text "{today:iso}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.12)
    section
      height: 11pt
      column
        width: 104pt
        text "{{today:%A, %B %-d, %Y}}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.45)
      column
        width: fill
        text "{today:%A, %B %-d, %Y}"
          font: IBM Plex Mono
          font-size: 6.5pt
          color: gray(0.12)
    section
      height: 11pt
      column
        width: 104pt
