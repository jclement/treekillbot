# STRESS 08b — DATES
#
# Everything date-shaped derives from ONE anchor, and --date reseeds it
# wholesale, so this sheet is a printout of the entire built-in namespace for
# whatever day you ask for.
#
# Build it once per edge case and check the printout against this list:
#
#   --date 2026-12-31   ISO 2026-W53; calendar year 2026
#   --date 2027-01-01   ISO 2026-W53 while today's year is 2027
#   --date 2021-01-01   ISO 2020-W53
#   --date 2024-02-29   a leap day; year.leap is true, day-of-year 60
#   --date 2027-02-15   month.end clamps to the 28th, not to 3 March
#   --date 2024-02-15   the same month in a leap year: month.end is the 29th
#   --week-start sunday rotates the day list and does NOT move week.number
#
# The trap this sheet exists for: "Week {week.number}, {year}" reads
# "Week 53, 2027" on 1 January 2027 and is wrong. Pair week.number with
# week.iso-year, never with the calendar year.

page
  size: letter
  margin: 0.5in

defaults
  font: IBM Plex Sans
  font-size: 8pt
  color: gray(0.12)

section
  height: 30pt
  column
    width: fill
    text "08b · DATES"
      font: IBM Plex Mono
      font-size: 14pt
      font-weight: bold
      tracking: 1.2pt
  column
    width: 290pt
    valign: bottom
    align: right
    text "anchor {today.iso} · {today.name} · ISO {week.iso}"
      font: IBM Plex Mono
      font-size: 9pt
      color: gray(0.3)
      align: right

section
  height: 20pt
  text "Every built-in the date anchor produces, with the value it has today."
    font-size: 7.5pt
    color: gray(0.45)

