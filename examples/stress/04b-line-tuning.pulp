      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: checkbox
      line-pitch: 8mm
      checkbox-gutter: 20pt
    text "checkbox-gutter: 20pt"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: checkbox
      line-pitch: 8mm
      checkbox-rule: false
    text "checkbox-rule: false"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: checkbox
      line-pitch: 8mm
      lines: 3
      checkbox-size: 18pt
      checkbox-radius: 9pt
    text "size 18pt, radius 9pt"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt

section
  height: 20pt
  valign: bottom
  text "dot and graph lattices. The first two cells are adjacent and share the page lattice, so their dots line up across the gap; the third and fourth centre inside their own box instead."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: 118pt
  gap: 7pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: dotted
      line-pitch: 5mm
    text "grid-origin: page"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: dotted
      line-pitch: 5mm
    text "grid-origin: page"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
      line-style: dotted
      line-pitch: 5mm
      grid-origin: box
    text "grid-origin: box"
      font-size: 5.5pt
      color: gray(0.4)
      padding-top: 3pt
  column
    width: fill
    box
      height: 94pt
      border-width: 0.4pt
      border-color: gray(0.62)
      line-color: gray(0.78)
      line-width: 0.4pt
