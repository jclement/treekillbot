# STRESS 08 — UNICODE COVERAGE
#
# WHAT THE THREE EMBEDDED FACES ACTUALLY DRAW.
#
# This sheet is deliberately built so that nothing on it is dropped: every
# sample is set in a family that has the glyphs, and everything the fonts do
# NOT have is named in ASCII rather than shown. A stress sheet that silently
# lost half its characters would teach exactly the wrong lesson, because that
# is what the tool does with a glyph it cannot find: gopdf substitutes a space,
# and only the CLI's summary tells you.
#
# The warning looks like this, on stderr, once per build:
#
#   treekillbot: warning: some characters are not in any embedded font and
#   were dropped: 'Α' (U+0391), 'Β' (U+0392), … and 47 more
#
# There is no font fallback. Only IBM Plex Mono, Sans and Serif are embedded
# (`--font-dir` adds more), so a document that needs CJK needs a CJK font.
#
# THERE IS NO RTL AND NO COMPLEX-SCRIPT SHAPING. Text is measured and drawn
# left to right by advance width (DESIGN.md section 6). Hebrew and Arabic are
# not merely unglyphed here — even with a font that had them, they would come
# out in logical order, unshaped and unjoined. Do not use this tool for them.

page
  size: letter
  margin: 0.5in

defaults
  font: IBM Plex Sans
  font-size: 8pt
  color: gray(0.12)

section
  height: 28pt
  text "08 · UNICODE COVERAGE"
    font: IBM Plex Mono
    font-size: 14pt
    font-weight: bold
    tracking: 1.2pt

section
  height: 24pt
  text "Each sample is set in the family named at the head of its column. A dash means that family has no glyphs for the set."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: 18pt
  border-bottom-width: 0.5pt
  border-color: gray(0.5)
  gap: 8pt
  column
    width: 118pt
    text "set"
      font-size: 6pt
      color: gray(0.4)
      text-transform: upper
      tracking: 0.6pt
  column
    width: fill
    text "IBM Plex Mono"
      font-size: 6pt
      color: gray(0.4)
      text-transform: upper
      tracking: 0.6pt
  column
    width: fill
    text "IBM Plex Sans"
      font-size: 6pt
      color: gray(0.4)
      text-transform: upper
      tracking: 0.6pt
  column
    width: fill
    text "IBM Plex Serif"
      font-size: 6pt
      color: gray(0.4)
      text-transform: upper
      tracking: 0.6pt

