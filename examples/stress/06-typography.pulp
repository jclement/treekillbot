section
  height: 26pt
  valign: bottom
  text "text-transform is applied at render time, so the source still says what you wrote."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: 60pt
  gap: 10pt
  column
    width: fill
    box
      height: 46pt
      border-width: 0.4pt
      border-color: gray(0.6)
      padding: 5pt
      text "the Quick brown FOX"
        font-size: 8pt
        text-transform: none
    text "text-transform: none"
      font-size: 5.5pt
      color: gray(0.4)
  column
    width: fill
    box
      height: 46pt
      border-width: 0.4pt
      border-color: gray(0.6)
      padding: 5pt
      text "the Quick brown FOX"
        font-size: 8pt
        text-transform: upper
    text "text-transform: upper"
      font-size: 5.5pt
      color: gray(0.4)
  column
    width: fill
    box
      height: 46pt
      border-width: 0.4pt
      border-color: gray(0.6)
      padding: 5pt
      text "the Quick brown FOX"
        font-size: 8pt
        text-transform: lower
    text "text-transform: lower"
      font-size: 5.5pt
      color: gray(0.4)
  column
    width: fill
    box
      height: 46pt
      border-width: 0.4pt
      border-color: gray(0.6)
      padding: 5pt
      text "the Quick brown FOX"
        font-size: 8pt
        text-transform: title
    text "text-transform: title"
      font-size: 5.5pt
      color: gray(0.4)

section
  height: 26pt
  valign: bottom
  text "tracking, in points, applied between glyphs. Negative values are legal and are how a big number gets set tight."
    font-size: 7.5pt
    color: gray(0.45)

section
  height: auto
  padding-top: 3pt
  column
    width: 60pt
    valign: middle
    text "-0.4pt"
      font: IBM Plex Mono
      font-size: 6pt
      color: gray(0.45)
  column
    width: fill
    text "TRACKING SAMPLE 0123"
      font-size: 11pt
      tracking: -0.4pt

section
  height: auto
  padding-top: 3pt
  column
    width: 60pt
    valign: middle
    text "0pt"
      font: IBM Plex Mono
      font-size: 6pt
      color: gray(0.45)
  column
    width: fill
    text "TRACKING SAMPLE 0123"
      font-size: 11pt
      tracking: 0pt

section
  height: auto
  padding-top: 3pt
  column
    width: 60pt
    valign: middle
    text "0.5pt"
      font: IBM Plex Mono
      font-size: 6pt
      color: gray(0.45)
  column
    width: fill
    text "TRACKING SAMPLE 0123"
      font-size: 11pt
      tracking: 0.5pt

section
  height: auto
  padding-top: 3pt
  column
    width: 60pt
    valign: middle
    text "1.5pt"
      font: IBM Plex Mono
      font-size: 6pt
      color: gray(0.45)
  column
    width: fill
    text "TRACKING SAMPLE 0123"
      font-size: 11pt
      tracking: 1.5pt

section
  height: auto
  padding-top: 3pt
  column
    width: 60pt
    valign: middle
    text "3pt"
      font: IBM Plex Mono
      font-size: 6pt
      color: gray(0.45)
  column
    width: fill
    text "TRACKING SAMPLE 0123"
      font-size: 11pt
      tracking: 3pt

section
  height: fill
  valign: bottom
  text "A family name resolves case- and space-insensitively and answers to its suffixes, so `mono`, `plex mono` and `IBM Plex Mono` are the same family. An unknown family silently draws nothing rather than substituting, so check the summary's font count if a run disappears."
    font-size: 6.5pt
    color: gray(0.5)
