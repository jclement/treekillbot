      font-size: 5.5pt
      color: gray(0.4)
      align: center
      padding-top: 4pt
  column
    width: fill
    box
      height: 76pt
      border-left-width: 3pt
      border-color: gray(0.35)
      line-style: ruled
      line-pitch: 5mm
      line-color: gray(0.8)
      line-inset: 0pt 0pt 0pt 8pt
    text "left rule + line-inset"
      font-size: 5.5pt
      color: gray(0.4)
      align: center
      padding-top: 4pt

section
  height: fill
  valign: bottom
  text "gray(0.94) is about as dark as a fill under a writing area should go on plain stock: a 6% tint halftones two or three steps darker in print than it looks on a monitor. The shipped themes use no fills at all."
    font-size: 6.5pt
    color: gray(0.5)
